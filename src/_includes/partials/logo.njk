{# ---------------------------------------------------------------
   LOGO-SLOT

   Exakt dasselbe Markup wie im Kopfbereich (hero.njk, betreut vom
   Design-Team). Beide Stellen müssen identisch bleiben — die
   Klassennamen .cp-logo und .cp-logo-fallback werden in
   signature.css gestaltet.

   Platz ist fest reserviert: 160x40 Desktop, 120x30 Mobil.
   Fehlt src/assets/logo.svg, ersetzt der onerror-Handler das Bild
   durch den Schriftzug. Siehe README, "Logo einsetzen".
   --------------------------------------------------------------- #}

<a class="cp-logo" href="/" aria-label="{{ site.name }}">
  <img src="/assets/logo.svg" alt="{{ site.name }}" width="160" height="40"
       onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'cp-logo-fallback',textContent:'Creative Potatoes'}))">
</a>
