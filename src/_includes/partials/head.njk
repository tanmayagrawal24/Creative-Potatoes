{# ---------------------------------------------------------------
   Alles im <head>: Titel, Beschreibung, Social-Media-Vorschau,
   canonical URL und die strukturierten Daten für Suchmaschinen.
   Inhalte kommen aus src/_data/site.json und aus dem Kopfbereich
   der jeweiligen Seite (title / description).
   --------------------------------------------------------------- #}

{%- set pageTitle = title or site.name -%}
{%- set pageDescription = description or site.description -%}
{%- set canonical = page.url | absoluteUrl(site.url) -%}
{%- set ogImage = "/assets/og-image.jpg" | absoluteUrl(site.url) -%}

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
<link rel="canonical" href="{{ canonical }}">

<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="{{ site.locale }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ ogImage }}">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDescription }}">
<meta name="twitter:image" content="{{ ogImage }}">

<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">

<link rel="stylesheet" href="/css/tokens.css">
<link rel="stylesheet" href="/css/base.css">
<link rel="stylesheet" href="/css/sections.css">
<link rel="stylesheet" href="/css/signature.css">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "{{ site.url }}/#organization",
      "name": "{{ site.name }}",
      "url": "{{ site.url }}",
      "slogan": "{{ site.tagline }}",
      "description": "{{ site.description }}",
      "email": "{{ site.email }}",
      "logo": {
        "@type": "ImageObject",
        "url": "{{ '/assets/logo.svg' | absoluteUrl(site.url) }}"
      },
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "contactType": "sales",
          "email": "{{ site.email }}",
          "availableLanguage": ["de", "en"],
          "areaServed": ["DE", "AT", "CH"]
        }
      ]
    },
    {
      "@type": "ProfessionalService",
      "@id": "{{ site.url }}/#service",
      "name": "{{ site.name }}",
      "url": "{{ site.url }}",
      "description": "{{ site.description }}",
      "email": "{{ site.email }}",
      "parentOrganization": { "@id": "{{ site.url }}/#organization" },
      "areaServed": [
        { "@type": "Country", "name": "Deutschland", "identifier": "DE" },
        { "@type": "Country", "name": "Österreich", "identifier": "AT" },
        { "@type": "Country", "name": "Schweiz", "identifier": "CH" }
      ],
      "availableLanguage": ["de", "en"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Leistungen",
        "itemListElement": [
          {%- for group in services %}
          {
            "@type": "OfferCatalog",
            "name": {{ group.title | dump | safe }},
            "itemListElement": [
              {%- for item in group.items %}
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": {{ item.name | dump | safe }},
                  "description": {{ item.description | dump | safe }}
                }
              }{% if not loop.last %},{% endif %}
              {%- endfor %}
            ]
          }{% if not loop.last %},{% endif %}
          {%- endfor %}
        ]
      }
    },
    {
      "@type": "WebSite",
      "@id": "{{ site.url }}/#website",
      "url": "{{ site.url }}",
      "name": "{{ site.name }}",
      "inLanguage": "de-DE",
      "publisher": { "@id": "{{ site.url }}/#organization" }
    }
  ]
}
</script>
