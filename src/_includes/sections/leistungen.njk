{# Inhalte: src/_data/services.json — fünf Leistungssäulen.
   Jede Säule: id, title, teaser, bullets[]; badge ist optional und
   erzeugt eine sichtbare Auszeichnung (z. B. GEO = Kernkompetenz). #}

<section class="cp-section cp-leistungen" id="leistungen" aria-labelledby="leistungen-titel">
  <div class="cp-container">

    <p class="cp-kicker">Leistungen</p>
    <h2 class="cp-h2" id="leistungen-titel">Fünf Hebel für digitale Sichtbarkeit.</h2>

    <div class="cp-pillars">
      {%- for pillar in services %}
      <article class="cp-pillar" id="{{ pillar.id }}">
        <div class="cp-pillar__head">
          <h3 class="cp-pillar__title">{{ pillar.title }}</h3>
          {%- if pillar.badge %}
          <span class="cp-pillar__badge">{{ pillar.badge }}</span>
          {%- endif %}
        </div>

        <p class="cp-pillar__teaser">{{ pillar.teaser }}</p>

        <ul class="cp-pillar__bullets" role="list">
          {%- for bullet in pillar.bullets %}
          <li class="cp-pillar__bullet">{{ bullet }}</li>
          {%- endfor %}
        </ul>
      </article>
      {%- endfor %}
    </div>

  </div>
</section>
