{# Inhalte: src/_data/approach.json — ein Objekt mit "headline" und "steps" #}

<section class="cp-section cp-ansatz" id="ansatz" aria-labelledby="ansatz-titel">
  <div class="cp-container">

    <p class="cp-kicker">Ansatz</p>
    <h2 class="cp-h2" id="ansatz-titel">{{ approach.headline }}</h2>

    <ol class="cp-ansatz__steps" role="list">
      {%- for stage in approach.steps %}
      <li class="cp-ansatz__step">
        <span class="cp-ansatz__number" aria-hidden="true">{{ stage.step }}</span>
        <h3 class="cp-ansatz__title">{{ stage.title }}</h3>
        <p class="cp-ansatz__description">{{ stage.description }}</p>
      </li>
      {%- endfor %}
    </ol>

  </div>
</section>
