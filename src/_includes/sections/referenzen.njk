{# Inhalte: src/_data/references.json — derzeit Platzhaltereinträge #}

<section class="cp-section cp-referenzen" id="referenzen" aria-labelledby="referenzen-titel">
  <div class="cp-container">

    <h2 class="cp-section__label" id="referenzen-titel">Referenzen</h2>

    <ul class="cp-referenzen__list" role="list">
      {%- for reference in references %}
      <li class="cp-referenz">
        <h3 class="cp-referenz__client">
          {%- if reference.url %}
          <a class="cp-referenz__link" href="{{ reference.url }}" rel="noopener noreferrer" target="_blank">{{ reference.client }}</a>
          {%- else %}
          {{ reference.client }}
          {%- endif %}
        </h3>
        <p class="cp-referenz__sector">{{ reference.sector }}</p>
        <p class="cp-referenz__summary">{{ reference.summary }}</p>
        {%- if reference.result %}
        <p class="cp-referenz__result">{{ reference.result }}</p>
        {%- endif %}
      </li>
      {%- endfor %}
    </ul>

  </div>
</section>
