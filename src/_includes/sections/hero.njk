{# hero.njk — Startbereich Creative Potatoes
   OWNED BY DESIGN AGENT.
   Dies ist der <header> der Seite. Die Shell darf KEINEN weiteren Header rendern.
   Erwartete Datenwerte in site.json:
     kicker, tagline, originStatementA, originStatementB,
     heroSubline, lede, ctaPrimary, ctaSecondary
#}
<header class="sig-hero">
  <div class="sig-shell">
    <nav class="sig-topbar" aria-label="Hauptnavigation">
      <a class="cp-logo" href="/" aria-label="Creative Potatoes">
        <img src="/assets/logo.svg" alt="Creative Potatoes" width="160" height="40"
             onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'cp-logo-fallback',textContent:'Creative Potatoes'}))">
      </a>
      <a class="sig-topbar-link" href="#kontakt">Kontakt</a>
    </nav>

    <div class="sig-hero-stage">
      <p class="sig-kicker">{{ site.kicker }}</p>

      <h1 class="sig-h1">{{ site.tagline.slice(0, -1) }}<span class="sig-dot">{{ site.tagline.slice(-1) }}</span></h1>

      <p class="sig-claim">
        <span class="sig-claim-half">{{ site.originStatementA }}</span>
        <span class="sig-claim-half">{{ site.originStatementB }}</span>
      </p>

      <p class="sig-subline">{{ site.heroSubline }}</p>

      <p class="sig-lede">{{ site.lede }}</p>

      <p class="sig-cta-row">
        <a class="sig-cta" href="#kontakt">{{ site.ctaPrimary }}</a>
        <a class="sig-cta-secondary" href="#leistungen">{{ site.ctaSecondary }}</a>
      </p>
    </div>
  </div>
</header>
