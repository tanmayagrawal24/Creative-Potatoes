{# Inhalte: site.originStatement und site.proofPoints in src/_data/site.json #}

<section class="cp-section cp-positionierung" id="positionierung" aria-labelledby="positionierung-titel">
  <div class="cp-container">

    <h2 class="cp-section__label" id="positionierung-titel">Positionierung</h2>

    <p class="cp-positionierung__origin">{{ site.originStatement }}</p>

    <ul class="cp-proofpoints" role="list">
      {%- for point in site.proofPoints %}
      <li class="cp-proofpoint">
        <h3 class="cp-proofpoint__label">{{ point.label }}</h3>
        <p class="cp-proofpoint__description">{{ point.description }}</p>
      </li>
      {%- endfor %}
    </ul>

  </div>
</section>
