{# Inhalte: site.email und site.tagline in src/_data/site.json #}

<section class="cp-section cp-kontakt" id="kontakt" aria-labelledby="kontakt-titel">
  <div class="cp-container">

    <h2 class="cp-section__label" id="kontakt-titel">Kontakt</h2>

    <p class="cp-kontakt__lead">{{ site.tagline }}</p>

    <p class="cp-kontakt__text">
      Erzählen Sie uns kurz, woran Sie arbeiten. Wir melden uns innerhalb von zwei Werktagen.
    </p>

    <a class="cp-kontakt__email" href="mailto:{{ site.email }}">{{ site.email }}</a>

  </div>
</section>
