{# craft.njk — „Vom Storyboard zum Screen" (Deck, Seite 6)
   OWNED BY DESIGN AGENT. Erste Person Singular. #}
<section class="sig-craft" id="craft" aria-labelledby="sig-craft-title">
  <div class="sig-shell">
    <header class="sig-craft-head">
      <p class="sig-kicker">{{ ui.craftKicker }}</p>
      <h2 class="sig-h2" id="sig-craft-title">{{ ui.craftHeadline }}</h2>
      <p class="sig-stand">{{ ui.craftStand }}</p>
    </header>

    <ol class="sig-stages">
      <li class="sig-stage">
        <div class="sig-stage-copy">
          <span class="sig-stage-num" aria-hidden="true">01</span>
          <h3 class="sig-h3">{{ ui.craft1Title }}</h3>
          <p>{{ ui.craft1Text }}</p>
        </div>
        <figure class="sig-frame" data-slot="craft-1">
          <img src="/assets/craft-1.svg" alt="" loading="eager" width="1600" height="900">
          <figcaption class="sig-sr-only">{{ ui.craft1Caption }}</figcaption>
        </figure>
      </li>

      <li class="sig-stage">
        <div class="sig-stage-copy">
          <span class="sig-stage-num" aria-hidden="true">02</span>
          <h3 class="sig-h3">{{ ui.craft2Title }}</h3>
          <p>{{ ui.craft2Text }}</p>
        </div>
        <figure class="sig-frame" data-slot="craft-2">
          <img src="/assets/craft-2.svg" alt="" loading="eager" width="1600" height="900">
          <figcaption class="sig-sr-only">{{ ui.craft2Caption }}</figcaption>
        </figure>
      </li>

      <li class="sig-stage">
        <div class="sig-stage-copy">
          <span class="sig-stage-num" aria-hidden="true">03</span>
          <h3 class="sig-h3">{{ ui.craft3Title }}</h3>
          <p>{{ ui.craft3Text }}</p>
        </div>
        <figure class="sig-frame" data-slot="craft-3">
          <img src="/assets/craft-3.svg" alt="" loading="eager" width="1600" height="900">
          <figcaption class="sig-sr-only">{{ ui.craft3Caption }}</figcaption>
        </figure>
      </li>
    </ol>
  </div>
</section>
