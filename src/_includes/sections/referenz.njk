{# Referenz — anonymisiert, ohne Kundenname.
   Der Fließtext ist bewusst ein Platzhalter: Referenzaussagen und
   Kennzahlen trägt der Inhaber selbst ein. Hier werden keine Zahlen
   erfunden. #}

<section class="cp-section cp-referenz" id="referenz" aria-labelledby="referenz-titel">
  <div class="cp-container">

    <p class="cp-kicker">{{ ui.referenzKicker }}</p>
    <h2 class="cp-h2" id="referenz-titel">{{ ui.referenzHeadline }}</h2>

    <div class="cp-referenz__body">
      <p>{{ ui.referenzBody }}</p>
    </div>

  </div>
</section>
